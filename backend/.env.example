# MySQL is recommended for real development and production.
DATABASE_URL=mysql+pymysql://madhav_user:change_me@127.0.0.1:3306/madhav_fashion

SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@madhavfashionstudio.com
ADMIN_PASSWORD=change-admin-password
SELLER_EMAIL=seller@madhavfashionstudio.com
