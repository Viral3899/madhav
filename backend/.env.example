# ── Copy this file to .env and fill in your values ──────────────
# cp .env.example .env

# JWT signing secret — change this to a long random string in production
SECRET_KEY=madhav-fashion-change-in-production

# Default admin account created on first startup
ADMIN_EMAIL=admin@madhavfashionstudio.com
ADMIN_PASSWORD=admin123

# Separate shop-holder registration key. Change before deployment.
ADMIN_SIGNUP_KEY=madhav-shop-holder-setup

# Development-only customer account
CUSTOMER_EMAIL=customer@madhavfashionstudio.com
CUSTOMER_PASSWORD=customer123

# Extra CORS origins (comma-separated), e.g. your production domain
# CORS_ORIGINS=https://myshop.com,https://admin.myshop.com
